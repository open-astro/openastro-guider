TAGS
/tmp*
/.vscode

# Debian package build
# debian/changelog is generated by build-deb.sh from CHANGELOG.md + version.md
debian/changelog
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.debhelper
debian/*.debhelper.log
debian/*.substvars
debian/openastro-phd2/
debian/phd2-alpaca/

# dpkg-buildpackage / dh_auto_configure out-of-tree build
obj-*/

# Local CMake build output (build/run-clang-format is tracked)
/build/*
!/build/run-clang-format

# Built .deb and related files (if built from repo root)
*.deb
*.buildinfo
*.changes
*.dsc
*.tar.xz
*.tar.gz

# Python bytecode/cache
__pycache__/
*.pyc
*.pyo

# Claude Code per-user settings (not the shared settings.json)
.claude/settings.local.json

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Built .dmg artifacts (if built from repo root)
*.dmg
