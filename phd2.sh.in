#!/bin/sh
# Prefer the openastro-guider dir; fall back to the legacy phd2 dir (where
# CMake installs the bundled libs) for upstream-compatible installs.
export LD_LIBRARY_PATH="@CMAKE_INSTALL_PREFIX@/lib/openastro-guider:@CMAKE_INSTALL_PREFIX@/lib/phd2${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$0.bin" "$@"
