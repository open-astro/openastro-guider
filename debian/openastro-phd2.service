[Unit]
Description=OpenAstro PHD2 Headless Guiding Server
Documentation=https://github.com/open-astro/openastro-guider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openastro-phd2
Group=openastro-phd2
WorkingDirectory=/var/lib/openastro-phd2
Environment=LD_LIBRARY_PATH=/usr/lib/openastro-phd2
# Headless is the default run mode; --auto-connect brings up the selected
# equipment on boot. wxGTK still needs a display to initialize even with the
# window hidden, so the daemon runs under a headless X server (Xvfb) — see
# design/GUIDER_DECISIONS.md for the display-strategy rationale.
ExecStart=/usr/bin/xvfb-run -a /usr/bin/openastro-phd2 --auto-connect
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
