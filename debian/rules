#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#DH_VERBOSE = 1

# NOTE: debian/changelog is a generated artifact (gitignored), derived from
# version.md + CHANGELOG.md by scripts/changelog_to_deb.py. Use ./build-deb.sh
# (the supported entry point) — it generates the file before packaging. A bare
# dpkg-buildpackage fails up front with "fatal error ... debian/changelog: No
# such file" because dpkg reads it before any rule here runs; run build-deb.sh
# once (or call changelog_to_deb.py yourself) to create it first.

# see EXAMPLES in dpkg-buildflags(1) and read /usr/share/dpkg/*
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

# Build accelerators (same setup as AlpacaBridge): the Ninja generator and
# the ccache compiler launcher, each used only when installed so a bare
# dpkg-buildpackage still works without them. Neither is a hard
# Build-Depends; build-deb.sh auto-installs both.
ifneq (,$(shell command -v ninja 2>/dev/null))
BUILDSYSTEM = cmake+ninja
else
BUILDSYSTEM = cmake
endif
ifneq (,$(shell command -v ccache 2>/dev/null))
CCACHE_ARGS = -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
# debhelper compat 13 runs the build with HOME pointed at a scratch dir under
# debian/.debhelper/ that dh clean wipes, so ccache's HOME-derived default
# cache would be discarded between runs. Pin the real cache dir instead
# (still overridable via the environment).
export CCACHE_DIR ?= $(HOME)/.cache/ccache
endif

# main packaging script based on dh7 syntax
%:
	dh $@ --buildsystem=$(BUILDSYSTEM)

override_dh_auto_configure:
	@set -e; \
	VERSION="$$(grep -E '^[[:space:]]*[0-9]+\.[0-9]+\.[0-9]+([A-Za-z0-9._-]*)[[:space:]]*$$' $(CURDIR)/version.md | head -1 | sed -E 's/^[[:space:]]*//; s/[[:space:]]*$$//')"; \
	if [ -z "$$VERSION" ]; then \
		echo "ERROR: Could not read version from version.md"; \
		exit 1; \
	fi; \
	CHANGELOG_VERSION="$$(dpkg-parsechangelog -S Version | sed -E 's/-[^-]+$$//')"; \
	if [ "$$CHANGELOG_VERSION" != "$$VERSION" ]; then \
		echo "Syncing debian/changelog version $$CHANGELOG_VERSION -> $$VERSION"; \
		sed -i -E "1 s/^openastro-guider \\([^)]*\\) /openastro-guider ($$VERSION) /" $(CURDIR)/debian/changelog; \
	fi
	dh_auto_configure --buildsystem=$(BUILDSYSTEM) -- -DUSE_SYSTEM_GTEST=1 -DOPENSOURCE_ONLY=1 $(CCACHE_ARGS)

# Force ctest to run even when DEB_BUILD_OPTIONS=nocheck is set. The fork
# does not ship through Debian autobuilders, so honouring the standard
# nocheck escape hatch isn't useful here — we'd rather catch a failing
# test than ship a broken .deb. To skip the suite entirely, reconfigure
# the cmake project with -DPHD_BUILD_TESTS=OFF.
#
# We invoke ctest directly instead of dh_auto_test because dh_auto_test
# itself respects nocheck and short-circuits before running anything.
#
# Build-dir resolution is deterministic-first: try the canonical
# obj-$(DEB_HOST_GNU_TYPE) (what dh_auto_configure creates by default), and
# only fall back to a sorted glob if that's missing. The glob is sorted so
# multiple obj-*-linux-* dirs (e.g. residue from a prior cross-build) pick
# the same one across runs instead of relying on filesystem ordering.
override_dh_auto_test:
	@build_dir="obj-$(DEB_HOST_GNU_TYPE)"; \
	if [ ! -d "$$build_dir" ]; then \
		build_dir=$$(find . -maxdepth 1 -type d -name 'obj-*-linux-*' | sort | head -1); \
	fi; \
	if [ -z "$$build_dir" ] || [ ! -f "$$build_dir/CTestTestfile.cmake" ]; then \
		echo "ERROR: cmake build dir with CTestTestfile.cmake not found (tried obj-$(DEB_HOST_GNU_TYPE) and obj-*-linux-* glob)" >&2; \
		exit 1; \
	fi; \
	echo "Running ctest in $$build_dir"; \
	cd "$$build_dir" && ctest --output-on-failure

# Force the install destdir to debian/openastro-guider/. With a single binary
# package in debian/control, dh_auto_install would do this automatically;
# the transitional stanzas (openastro-phd2 + phd2-alpaca, Architecture: all,
# no files) make debhelper switch to the multi-package default of debian/tmp/
# and then distribute via .install files, which would break the path-specific
# overrides below. The transitional packages own no files anyway, so pinning
# the destdir keeps the existing layout.
override_dh_auto_install:
	dh_auto_install --destdir=$(CURDIR)/debian/openastro-guider
	# Rename the wrapper and binary from 'phd2' to 'openastro-guider'.
	# The wrapper script (phd2) uses exec "$0.bin" so both must match.
	# These mv's are unconditional on purpose: if CMake ever stops installing
	# these (renamed target, build-config change), the package build fails here
	# rather than silently shipping a package whose systemd service can't start.
	mv $(CURDIR)/debian/openastro-guider/usr/bin/phd2 \
	   $(CURDIR)/debian/openastro-guider/usr/bin/openastro-guider
	mv $(CURDIR)/debian/openastro-guider/usr/bin/phd2.bin \
	   $(CURDIR)/debian/openastro-guider/usr/bin/openastro-guider.bin

# dwz can fail on large C++ binaries — skip it
override_dh_dwz:
